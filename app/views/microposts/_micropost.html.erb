<li id="micropost-<%= micropost.id %>"
    class="list-group-item d-flex gap-3 px-0 py-3">
  <%= link_to gravatar_for(micropost.user, size: 50),
              micropost.user,
              class: "flex-shrink-0" %>

  <div class="flex-grow-1 overflow-hidden">
    <span class="user d-block fw-semibold mb-1">
      <%= link_to micropost.user.name,
                  micropost.user,
                  class: "text-decoration-none" %>
    </span>

    <span class="content d-block mb-2">
      <%= micropost.content %>

      <% if micropost.image.attached? %>
        <%= image_tag micropost.image.variant(:display),
                      class: "img-fluid rounded mt-2" %>
      <% end %>
    </span>

    <span class="timestamp text-body-secondary">
      Posted <%= time_ago_in_words(micropost.created_at) %> ago.

      <% if current_user?(micropost.user) %>
        <%= link_to "delete",
                    micropost,
                    class: "link-danger ms-2",
                    data: {
                      turbo_method: :delete,
                      turbo_confirm: "Are you sure?"
                    } %>
      <% end %>
    </span>
  </div>
</li>
