<% provide(:title, @user.name) %>

<div class="row justify-content-center">
  <aside class="col-md-6 col-lg-4">
    <section class="card shadow-sm text-center">
      <div class="card-body">
        <div class="mb-3"><%= gravatar_for @user %></div>
        <h1 class="h3 card-title mb-0"><%= @user.name %></h1>
      </div>
    </section>

    <section class="stats">
      <%= render "shared/stats" %>
    </section>

    <%= render "follow_form" if logged_in? %>
  </aside>
</div>

<% if @user.microposts.any? %>
  <h3 class="mt-4 mb-3">
    Microposts (<%= @user.microposts.count %>)
  </h3>

  <ol class="microposts list-group list-group-flush mb-4">
    <%= render @microposts %>
  </ol>

  <%= will_paginate @microposts %>
<% end %>
