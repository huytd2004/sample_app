<% if @user.errors.any? %>
  <div id="error_explanation" class="alert alert-danger" role="alert">
    <h2 class="h6 alert-heading">
      The form contains <%= pluralize(@user.errors.count, "error") %>:
    </h2>
    <ul class="mb-0">
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
